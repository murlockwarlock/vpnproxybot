# Telegram Bot
BOT_TOKEN=
ADMIN_IDS=272982544,806750628

# Database
DATABASE_URL=sqlite+aiosqlite:///./vpn_bot.db

# VPN Servers (JSON list)
# Managed via admin panel, but can be seeded here
# VPN_SERVERS=[{"name":"NL-1","host":"1.2.3.4","location":"Amsterdam","emoji":"🇳🇱","ssh_user":"root","ssh_key_path":"~/.ssh/id_rsa"}]

# Payment — Telegram Pay (native card via Telegram API, optional)
# Get provider token from @BotFather → Payments → connect provider
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# Payment — YooKassa (optional)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Payment — Robokassa (optional)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=

# Payment webhook server
APP_PORT=8080
BASE_WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH_PREFIX=/vpnbot
SUB_PROFILE_TITLE=Ускоритель интернета
SUB_SUPPORT_URL=https://t.me/your_support
SUB_PROFILE_WEB_PAGE_URL=https://your-domain.com
SUB_ANNOUNCE=
SUB_ANNOUNCE_URL=
SUB_UPDATE_INTERVAL=12

# External supplier - VHQ Partner API (optional)
VHQ_PARTNER_API_URL=https://yhmaeogxdxqszffrbjui.supabase.co/functions/v1/partner-api
VHQ_PARTNER_API_KEY=

# Mode
MOCK_MODE=true
LOG_LEVEL=INFO
